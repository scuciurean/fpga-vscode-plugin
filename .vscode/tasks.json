// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
		  "label": "npm: compile",
		  "type": "npm",
		  "script": "compile",
		  "problemMatcher": [],
		  "detail": "Run the compile script",
		  "group": {
			  "kind": "build",
			  "isDefault": true
		  }
		},
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
			}
		},
		{
			"label": "[Components] Wizard",
			"type": "shell",
			"command": "npm run build",
			"options": {
				"cwd": "${workspaceFolder}/src/components/wizard"
			},
			"problemMatcher": [],
			"group": {
				"kind": "build",
			}
		},
		{
			"label": "[Components] AnotherComponent",
			"type": "shell",
			"command": "echo ok",
			"options": {
				"cwd": "${workspaceFolder}/src/components/anotherComponent"
			},
			"problemMatcher": [],
			"group": {
				"kind": "build",
			}
		},
		{
			"label": "Build All Components",
			"dependsOn": [
				"[Components] Wizard",
				"[Components] AnotherComponent"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
